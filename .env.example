# ==============================================================================
# CAMPUS EVENT HUB - ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env and configure your credentials.
# ==============================================================================

# MongoDB Connection String (MongoDB Compass / Local MongoDB Server)
MONGODB_URI=mongodb://127.0.0.1:27017/campus_event_hub
MONGODB_DB_NAME=campus_event_hub

# JWT & Refresh Secrets for Institutional Session Security
JWT_SECRET=campus_event_hub_jwt_secret_2026_secure_key
REFRESH_SECRET=campus_event_hub_refresh_secret_2026_secure_key

# Backend Standalone Server Port
PORT=5000

# Institutional Allowed Email Domain
ALLOWED_EMAIL_DOMAIN=college.edu

# ==============================================================================
# 1. GOOGLE OAUTH 2.0 CREDENTIALS
# ==============================================================================
# Primary Google OAuth Web Client ID (Frontend & Backend):
# Used in the frontend by Google Identity Services (GIS) Sign-In button and One Tap.
# Must be prefixed with VITE_ to be available in Vite frontend code.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
# Backend Google Client Secret (STRICTLY CONFIDENTIAL - Never expose to frontend)
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Secondary Google Client ID (Optional):
# If you have two Google Client IDs (e.g. one for web and one for mobile/alternate origin,
# or separate staging and production projects), add the second Client ID here.
# The backend validates tokens against BOTH Client IDs seamlessly without conflicts.
GOOGLE_CLIENT_ID_SECONDARY=
VITE_GOOGLE_CLIENT_ID_SECONDARY=

# ==============================================================================
# 2. EMAIL NOTIFICATION PROVIDER (SMTP / Institutional Gateway)
# ==============================================================================
# Used for OD approval/rejection alerts, event tickets, winners notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM=Campus Event & OD Cell <noreply@college.edu>

# ==============================================================================
# 3. WHATSAPP & SMS NOTIFICATION PROVIDER (Twilio / Gateway Configuration)
# ==============================================================================
# Used for instant WhatsApp notifications and critical SMS alerts.
# If omitted, system seamlessly logs alerts and provides one-click WhatsApp/Webmail links.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Automated dispatch toggle
ENABLE_AUTOMATED_NOTIFICATIONS=true
